msgctxt "model:ir.message,text:msg_sale_history_company_product_date_unique"
msgid "A company and product can only have one sales history row per day."
msgstr ""
"Solo puede existir una fila de histórico de ventas por empresa, producto y "
"fecha."

msgctxt "model:ir.message,text:msg_calendar_date_unique"
msgid "A forecast calendar can only have one entry per day."
msgstr "Un calendario de previsión solo puede tener una entrada por día."

msgctxt "model:ir.message,text:msg_distribution_product_weekday_unique"
msgid "The weekday distribution must be unique per company and product."
msgstr ""
"La distribución por día de la semana debe ser única por empresa y producto."

msgctxt "model:ir.message,text:msg_manual_product_week_unique"
msgid "A product can only have one manual forecast per week."
msgstr "Un producto solo puede tener una previsión manual por semana."

msgctxt "model:ir.message,text:msg_calculation_category_unique"
msgid "The category increase must be unique per calculation."
msgstr "El incremento por categoría debe ser único por cálculo."

msgctxt "model:ir.message,text:msg_forecast_category_unique"
msgid "The category increase must be unique per forecast."
msgstr "El incremento por categoría debe ser único por previsión."

msgctxt "model:ir.message,text:msg_forecast_product_unique"
msgid "The product increase must be unique per forecast."
msgstr "El incremento por producto debe ser único por previsión."

msgctxt "model:ir.message,text:msg_forecast_product_week_unique"
msgid "A product can only have one forecast line per week."
msgstr "Un producto solo puede tener una línea de previsión por semana."

msgctxt "model:ir.message,text:msg_forecast_daily_line_unique"
msgid "A product can only have one daily forecast line per day."
msgstr "Un producto solo puede tener una línea de previsión diaria por día."

msgctxt "model:ir.message,text:msg_forecast_monthly_line_unique"
msgid "A product can only have one monthly forecast line per month."
msgstr "Un producto solo puede tener una línea de previsión mensual por mes."

msgctxt "model:ir.model.button,string:calculation_calculate_all_button"
msgid "Calculate All"
msgstr "Calcular todos"

