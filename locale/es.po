msgctxt "help:product.template,sales_forecast_boxes_per_pallet:"
msgid ""
"Fallback used when the selected package does not define boxes per pallet."
msgstr ""
"Valor utilizado cuando el empaquetado seleccionado no define las cajas por "
"palé."

msgctxt "help:product.template,sales_forecast_package:"
msgid ""
"Package used to display forecast quantities in boxes and pallets. If empty, "
"the default product package is used."
msgstr ""
"Empaquetado utilizado para mostrar las cantidades previstas en cajas y "
"palés. Si se deja vacío, se utiliza el empaquetado predeterminado del "
"producto."

msgctxt "model:ir.action,name:act_sales_forecast_calculation"
msgid "Calculate Sales Forecasts"
msgstr "Calcular previsiones de ventas"

msgctxt "model:ir.action,name:act_sales_forecast_manual_line"
msgid "Manual Weekly Forecasts"
msgstr "Previsiones semanales manuales"

msgctxt "model:ir.message,text:msg_manual_single_update"
msgid "Manual forecast quantities must be updated one line at a time."
msgstr ""
"Las cantidades de previsión manual deben actualizarse línea por línea."

msgctxt "model:ir.message,text:msg_manual_week_in_past"
msgid "A manual forecast can not be created in the past."
msgstr "No se puede crear una previsión manual en el pasado."

msgctxt "model:ir.message,text:msg_manual_week_readonly"
msgid "The product and week of a manual forecast can not be changed."
msgstr ""
"No se pueden cambiar el producto ni la semana de una previsión manual."

msgctxt "model:ir.message,text:msg_manual_week_sequence"
msgid "The next manual forecast for \"%(product)s\" must be week %(week)s."
msgstr ""
"La siguiente previsión manual del producto \"%(product)s\" debe corresponder"
" a la semana %(week)s."

msgctxt "model:ir.message,text:msg_missing_manual_line"
msgid "Product \"%(product)s\" has no manual forecast line to duplicate."
msgstr ""
"El producto \"%(product)s\" no tiene ninguna línea de previsión manual para "
"duplicar."

msgctxt "model:ir.message,text:msg_missing_manual_quantity"
msgid "A manual forecast for \"%(product)s\" requires units, boxes or pallets."
msgstr ""
"La previsión manual del producto \"%(product)s\" requiere unidades, cajas o "
"palés."

