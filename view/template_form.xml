<?xml version="1.0"?>
<data>
    <xpath expr="/form/notebook" position="inside">
        <page string="Planning" id="sale_forecast_planning" col="4">
            <label name="sale_forecast_method"/>
            <field name="sale_forecast_method"/>
            <label name="sale_forecast_package"/>
            <field name="sale_forecast_package"/>
            <label name="sale_forecast_boxes_per_pallet"/>
            <field name="sale_forecast_boxes_per_pallet"/>
            <label name="sale_forecast_new_product_source"/>
            <field name="sale_forecast_new_product_source"/>
            <label name="sale_forecast_new_product_increase_percentage"/>
            <field name="sale_forecast_new_product_increase_percentage" factor="100"/>
            <label name="sale_forecast_key_account_source"/>
            <field name="sale_forecast_key_account_source"/>
            <label name="sale_forecast_customer_trucks_per_week"/>
            <field name="sale_forecast_customer_trucks_per_week"/>
            <label name="sale_forecast_customer_pallets_per_truck"/>
            <field name="sale_forecast_customer_pallets_per_truck"/>
            <newline/>
            <field name="sale_forecast_distribution_lines" colspan="4"
                view_ids="sale_forecast.view_sale_forecast_distribution_tree"/>
            <newline/>
            <field name="sale_forecast_manual_lines" colspan="4"
                view_ids="sale_forecast.view_sale_forecast_manual_line_tree"/>
            <button name="duplicate_last_manual_forecast" colspan="4"/>
            <label name="sale_forecast_manual_updated_at"/>
            <field name="sale_forecast_manual_updated_at"/>
            <newline/>
            <label name="sale_forecast_last_calculated_at"/>
            <field name="sale_forecast_last_calculated_at"/>
            <field name="sale_forecast_lines" colspan="4"/>
        </page>
    </xpath>
</data>
